# Скопируйте в .env (он в .gitignore) и раскомментируйте один вариант LLM.
# Без LLM_BASE_URL и LLM_MODEL приложение работает с ответом-заглушкой.

# Токен страницы администратора /admin (иначе генерируется при каждом запуске)
# ADMIN_TOKEN=придумайте-длинный-токен

# --- Ollama (локально, бесплатно, работает без интернета) ---
# ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- YandexGPT (Yandex Cloud, OpenAI-совместимый API; сверьте с документацией Yandex Cloud) ---
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder_id>/yandexgpt-lite/latest
# LLM_API_KEY=<API-ключ сервисного аккаунта>
# LLM_AUTH_SCHEME=Api-Key
# LLM_PROJECT=<folder_id>

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=<ключ>

# --- OpenRouter (много моделей через один ключ) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<имя модели из каталога OpenRouter>
# LLM_API_KEY=<ключ>

# Необязательно
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0
